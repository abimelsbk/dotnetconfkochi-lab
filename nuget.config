<?xml version="1.0" encoding="utf-8"?>
<!-- Makes sure this project always downloads packages from nuget.org,
     even on laptops where NuGet has no package source set up. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
